// Camera gimbal mounting bracket
// Single solid two-axis support-style camera bracket with camera module holes and side pivot bores.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

overallWidth = 60mm
overallHeight = 50mm
bodyDepth = 12mm
bodyCutLength = bodyDepth + 2mm

armOuterX = 26mm
armInnerX = 18mm
armBottomZ = -25mm
armTopZ = 25mm

bridgeHalfWidth = 18.5mm
bridgeBottomZ = 17mm
bridgeTopZ = 25mm

cameraPlateHalfWidth = 18.5mm
cameraPlateBottomZ = -15mm
cameraPlateTopZ = 15mm

pivotBossDiameter = 8mm
pivotBossLength = 4mm
pivotBoreDiameter = 3.2mm
pivotBoreCutLength = 16mm
pivotHolePlaneX = 23mm

cameraHoleDiameter = 2.2mm
cameraHoleSpacingX = 20mm
cameraHoleSpacingZ = 20mm
lensHoleDiameter = 18mm

topMountHoleDiameter = 3.2mm
topMountHoleSpacing = 20mm
topMountHoleZ = 21mm

leftArmProfile = sketch(on = XZ) {
  bottom = line(start = [var -26mm, var -25mm], end = [var -18mm, var -25mm])
  right = line(start = [var -18mm, var -25mm], end = [var -18mm, var 25mm])
  top = line(start = [var -18mm, var 25mm], end = [var -26mm, var 25mm])
  left = line(start = [var -26mm, var 25mm], end = [var -26mm, var -25mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([ORIGIN, bottom.start]) == -armOuterX
  verticalDistance([ORIGIN, bottom.start]) == armBottomZ
  horizontalDistance([bottom.start, bottom.end]) == armOuterX - armInnerX
  verticalDistance([right.start, right.end]) == overallHeight
}

rightArmProfile = sketch(on = XZ) {
  bottom = line(start = [var 18mm, var -25mm], end = [var 26mm, var -25mm])
  right = line(start = [var 26mm, var -25mm], end = [var 26mm, var 25mm])
  top = line(start = [var 26mm, var 25mm], end = [var 18mm, var 25mm])
  left = line(start = [var 18mm, var 25mm], end = [var 18mm, var -25mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([ORIGIN, bottom.start]) == armInnerX
  verticalDistance([ORIGIN, bottom.start]) == armBottomZ
  horizontalDistance([bottom.start, bottom.end]) == armOuterX - armInnerX
  verticalDistance([right.start, right.end]) == overallHeight
}

topBridgeProfile = sketch(on = XZ) {
  bottom = line(start = [var -18.5mm, var 17mm], end = [var 18.5mm, var 17mm])
  right = line(start = [var 18.5mm, var 17mm], end = [var 18.5mm, var 25mm])
  top = line(start = [var 18.5mm, var 25mm], end = [var -18.5mm, var 25mm])
  left = line(start = [var -18.5mm, var 25mm], end = [var -18.5mm, var 17mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([ORIGIN, bottom.start]) == -bridgeHalfWidth
  verticalDistance([ORIGIN, bottom.start]) == bridgeBottomZ
  horizontalDistance([bottom.start, bottom.end]) == bridgeHalfWidth * 2
  verticalDistance([right.start, right.end]) == bridgeTopZ - bridgeBottomZ
}

cameraPlateProfile = sketch(on = XZ) {
  bottom = line(start = [var -18.5mm, var -15mm], end = [var 18.5mm, var -15mm])
  right = line(start = [var 18.5mm, var -15mm], end = [var 18.5mm, var 15mm])
  top = line(start = [var 18.5mm, var 15mm], end = [var -18.5mm, var 15mm])
  left = line(start = [var -18.5mm, var 15mm], end = [var -18.5mm, var -15mm])

  coincident([bottom.end, right.start])
  coincident([right.end, top.start])
  coincident([top.end, left.start])
  coincident([left.end, bottom.start])

  horizontal(bottom)
  vertical(right)
  horizontal(top)
  vertical(left)

  horizontalDistance([ORIGIN, bottom.start]) == -cameraPlateHalfWidth
  verticalDistance([ORIGIN, bottom.start]) == cameraPlateBottomZ
  horizontalDistance([bottom.start, bottom.end]) == cameraPlateHalfWidth * 2
  verticalDistance([right.start, right.end]) == cameraPlateTopZ - cameraPlateBottomZ
}

leftPivotBossProfile = sketch(on = offsetPlane(YZ, offset = -armOuterX)) {
  bossCircle = circle(start = [var 4mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([bossCircle.center, ORIGIN])
  diameter(bossCircle) == 8mm
  horizontal([bossCircle.center, bossCircle.start])
}

rightPivotBossProfile = sketch(on = offsetPlane(YZ, offset = armOuterX)) {
  bossCircle = circle(start = [var 4mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([bossCircle.center, ORIGIN])
  diameter(bossCircle) == 8mm
  horizontal([bossCircle.center, bossCircle.start])
}

frontHoleProfile = sketch(on = offsetPlane(XZ, offset = -bodyCutLength / 2)) {
  upperLeftCameraHole = circle(start = [var -8.9mm, var 10mm], center = [var -10mm, var 10mm])
  upperRightCameraHole = circle(start = [var 11.1mm, var 10mm], center = [var 10mm, var 10mm])
  lowerLeftCameraHole = circle(start = [var -8.9mm, var -10mm], center = [var -10mm, var -10mm])
  lowerRightCameraHole = circle(start = [var 11.1mm, var -10mm], center = [var 10mm, var -10mm])
  lensHole = circle(start = [var 9mm, var 0mm], center = [var 0mm, var 0mm])
  leftTopMountHole = circle(start = [var -8.4mm, var 21mm], center = [var -10mm, var 21mm])
  rightTopMountHole = circle(start = [var 11.6mm, var 21mm], center = [var 10mm, var 21mm])

  horizontal([
    upperLeftCameraHole.center,
    upperLeftCameraHole.start
  ])
  horizontal([
    upperRightCameraHole.center,
    upperRightCameraHole.start
  ])
  horizontal([
    lowerLeftCameraHole.center,
    lowerLeftCameraHole.start
  ])
  horizontal([
    lowerRightCameraHole.center,
    lowerRightCameraHole.start
  ])
  horizontal([lensHole.center, lensHole.start])
  horizontal([
    leftTopMountHole.center,
    leftTopMountHole.start
  ])
  horizontal([
    rightTopMountHole.center,
    rightTopMountHole.start
  ])

  diameter(upperLeftCameraHole) == cameraHoleDiameter
  diameter(upperRightCameraHole) == cameraHoleDiameter
  diameter(lowerLeftCameraHole) == cameraHoleDiameter
  diameter(lowerRightCameraHole) == cameraHoleDiameter
  diameter(lensHole) == lensHoleDiameter
  diameter(leftTopMountHole) == topMountHoleDiameter
  diameter(rightTopMountHole) == topMountHoleDiameter

  horizontalDistance([ORIGIN, upperLeftCameraHole.center]) == -cameraHoleSpacingX / 2
  verticalDistance([ORIGIN, upperLeftCameraHole.center]) == cameraHoleSpacingZ / 2
  horizontalDistance([ORIGIN, upperRightCameraHole.center]) == cameraHoleSpacingX / 2
  verticalDistance([ORIGIN, upperRightCameraHole.center]) == cameraHoleSpacingZ / 2
  horizontalDistance([ORIGIN, lowerLeftCameraHole.center]) == -cameraHoleSpacingX / 2
  verticalDistance([ORIGIN, lowerLeftCameraHole.center]) == -cameraHoleSpacingZ / 2
  horizontalDistance([ORIGIN, lowerRightCameraHole.center]) == cameraHoleSpacingX / 2
  verticalDistance([ORIGIN, lowerRightCameraHole.center]) == -cameraHoleSpacingZ / 2
  coincident([lensHole.center, ORIGIN])
  horizontalDistance([ORIGIN, leftTopMountHole.center]) == -topMountHoleSpacing / 2
  verticalDistance([ORIGIN, leftTopMountHole.center]) == topMountHoleZ
  horizontalDistance([ORIGIN, rightTopMountHole.center]) == topMountHoleSpacing / 2
  verticalDistance([ORIGIN, rightTopMountHole.center]) == topMountHoleZ
}

leftPivotHoleProfile = sketch(on = offsetPlane(YZ, offset = -pivotHolePlaneX)) {
  pivotHole = circle(start = [var 1.6mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([pivotHole.center, ORIGIN])
  diameter(pivotHole) == pivotBoreDiameter
  horizontal([pivotHole.center, pivotHole.start])
}

rightPivotHoleProfile = sketch(on = offsetPlane(YZ, offset = pivotHolePlaneX)) {
  pivotHole = circle(start = [var 1.6mm, var 0mm], center = [var 0mm, var 0mm])

  coincident([pivotHole.center, ORIGIN])
  diameter(pivotHole) == pivotBoreDiameter
  horizontal([pivotHole.center, pivotHole.start])
}

leftArmRegion = region(point = [-22mm, 0mm], sketch = leftArmProfile)
rightArmRegion = region(point = [22mm, 0mm], sketch = rightArmProfile)
topBridgeRegion = region(point = [0mm, 21mm], sketch = topBridgeProfile)
cameraPlateRegion = region(point = [0mm, 0mm], sketch = cameraPlateProfile)
leftPivotBossRegion = region(point = [0mm, 0mm], sketch = leftPivotBossProfile)
rightPivotBossRegion = region(point = [0mm, 0mm], sketch = rightPivotBossProfile)
upperLeftCameraHoleRegion = region(point = [-10mm, 10mm], sketch = frontHoleProfile)
upperRightCameraHoleRegion = region(point = [10mm, 10mm], sketch = frontHoleProfile)
lowerLeftCameraHoleRegion = region(point = [-10mm, -10mm], sketch = frontHoleProfile)
lowerRightCameraHoleRegion = region(point = [10mm, -10mm], sketch = frontHoleProfile)
lensHoleRegion = region(point = [0mm, 0mm], sketch = frontHoleProfile)
leftTopMountHoleRegion = region(point = [-10mm, 21mm], sketch = frontHoleProfile)
rightTopMountHoleRegion = region(point = [10mm, 21mm], sketch = frontHoleProfile)
leftPivotHoleRegion = region(point = [0mm, 0mm], sketch = leftPivotHoleProfile)
rightPivotHoleRegion = region(point = [0mm, 0mm], sketch = rightPivotHoleProfile)

leftArmBody = extrude(leftArmRegion, length = bodyDepth, symmetric = true)
rightArmBody = extrude(rightArmRegion, length = bodyDepth, symmetric = true)
topBridgeBody = extrude(topBridgeRegion, length = bodyDepth, symmetric = true)
cameraPlateBody = extrude(cameraPlateRegion, length = bodyDepth, symmetric = true)
leftPivotBossBody = extrude(leftPivotBossRegion, length = -pivotBossLength)
rightPivotBossBody = extrude(rightPivotBossRegion, length = pivotBossLength)

leftArmWithBoss = union([leftArmBody, leftPivotBossBody])
rightArmWithBoss = union([rightArmBody, rightPivotBossBody])
leftSideWithPlate = union([leftArmWithBoss, cameraPlateBody])
centerFrame = union([leftSideWithPlate, topBridgeBody])
baseFrame = union([centerFrame, rightArmWithBoss])

cameraMountingBracket = appearance(
  subtract(
    baseFrame,
    tools = [
      extrude(
        [
          upperLeftCameraHoleRegion,
          upperRightCameraHoleRegion,
          lowerLeftCameraHoleRegion,
          lowerRightCameraHoleRegion,
          lensHoleRegion,
          leftTopMountHoleRegion,
          rightTopMountHoleRegion
        ],
        length = bodyCutLength,
      ),
      extrude(leftPivotHoleRegion, length = pivotBoreCutLength, symmetric = true),
      extrude(rightPivotHoleRegion, length = pivotBoreCutLength, symmetric = true)
    ],
  ),
  color = "#2a3138",
  metalness = 0,
  roughness = 62,
)

hide(leftArmProfile)
hide(rightArmProfile)
hide(topBridgeProfile)
hide(cameraPlateProfile)
hide(leftPivotBossProfile)
hide(rightPivotBossProfile)
hide(frontHoleProfile)
hide(leftPivotHoleProfile)
hide(rightPivotHoleProfile)

cameraMountingBracket
